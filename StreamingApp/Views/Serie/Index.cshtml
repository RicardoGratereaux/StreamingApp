@using Application.ViewModels;
@model List<SerieViewModel>
@{
    ViewData["Title"] = "Series";
}

<div class="container-fluid">

    <div class="row mb-3">
        <div class="col-3 offset-9">
            <a asp-controller="Serie" asp-action="Create" class="btn btn-success">Create</a>
        </div>
    </div>

  <div class="row">
    @if (Model == null || Model.Count == 0)
    {
        <h2>No hay series disponibles</h2>
    }
    else
    {
        @foreach (SerieViewModel item in Model)
        {
                <div class="col-4 mb-3 mt-4">
                    <div class="card border-dark bg-primary-subtle" style="width: 18rem;">
                        <img src="@item.ImageUrl" class="card-img-top img-serie-size" alt="...">
                        <div class="m-3">
                            <div class="container-fluid text-center">
                                <h5 class="card-title">@item.Name</h5>
                            </div>
                        </div>
                        <div class="container-fluid text-center">
                            <div class="row align-items-center">
                                <div class="col">
                                    <span class="badge text-bg-success">@item.GenreName</span>
                                </div>
                                <div class="col">
                                    <span class="badge text-bg-danger">@item.ProducerName</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body mt-3">
                            <div class="d-flex justify-content align-items-center">
                                <div class="btn-group">
                                    <a asp-controller="Serie" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Edit</a>
                                    <a asp-controller="Serie" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        }
    }
  </div>
</div>