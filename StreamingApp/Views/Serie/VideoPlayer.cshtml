@using Application.ViewModels;
@model Application.ViewModels.SaveSerieViewModel
@{
    ViewData["Title"] = "Video Player";
}

<style>
    /* Estilo personalizado para ajustar el tamaño del reproductor de video */
    .video-container {
        width: 100%;
        padding-bottom: 56.25%; /* Proporción de aspecto 16:9 para el reproductor de video */
        position: relative;
    }

    /* Estilo personalizado para el reproductor de video dentro del contenedor */
    .video-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .my-navbar {
        display: none;
    }
</style>

<div class="container-fluid">
    <div class="row justify-content-center align-items-center" style="height: 100vh;">
        <div class="col-12 text-center">
            <h5>@Model.Name</h5>
            <div class="video-container">
                <iframe src="@Model.VideoUrl" title="Video Player" frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                        allowfullscreen></iframe>
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning mt-3">Volver</a>
        </div>
    </div>
</div>