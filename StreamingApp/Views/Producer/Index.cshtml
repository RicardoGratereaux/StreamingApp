@using Application.ViewModels;
@model List<Application.ViewModels.ProducerViewModel>
@{
    ViewData["Title"] = "Producers";
}

<div class="container-fluid">

    <div class="row mb-3">
        <div class="col-3 offset-9">
            <a asp-controller="Producer" asp-action="Create" class="btn btn-success">Create</a>
        </div>
    </div>

    <div class="row">
        @if (Model == null || Model.Count == 0)
        {
            <h2>No hay productoras disponibles</h2>
        }
        else
        {
            @foreach (ProducerViewModel item in Model)
            {
                <div class="col-4 mb-3 mt-4">
                    <div class="card border-dark bg-primary-subtle" style="width: 18rem;">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <div class="d-flex justify-content align-items-center">
                                <div class="btn-group">
                                    <a asp-controller="Producer" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">Edit</a>
                                    <a asp-controller="Producer" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>